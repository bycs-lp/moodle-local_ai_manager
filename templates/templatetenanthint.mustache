{{!
    @template local_ai_manager/templatetenanthint

    Hint shown below the heading of the tenant config pages of the template tenant.

    Example context (json):
    {
    }
}}
<div class="alert alert-warning d-flex align-items-center" role="status">
    <i class="fa fa-wand-magic-sparkles fa-lg me-2" aria-hidden="true"></i>
    <div>
        <strong>{{#str}} templatetenant_hint_heading, local_ai_manager {{/str}}</strong><br>
        {{#str}} templatetenant_hint, local_ai_manager {{/str}}
        {{#str}} templatetenant_hint_noautoupdate, local_ai_manager {{/str}}
    </div>
</div>
<div class="alert alert-danger d-flex align-items-center" role="alert">
    <i class="fa fa-triangle-exclamation fa-lg me-2" aria-hidden="true"></i>
    <div>
        <strong>{{#str}} templatetenant_credentialswarning_heading, local_ai_manager {{/str}}</strong><br>
        {{#str}} templatetenant_credentialswarning, local_ai_manager {{/str}}
    </div>
</div>
