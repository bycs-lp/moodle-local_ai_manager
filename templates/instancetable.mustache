{{!
    @template local_ai_manager/instancetable

    Template for the table that shows the current instances.

    Example context (json):
    {
        "tenant": "sometenantname",
        "purposesheadingrolebasic": "Purposes basic role (3 of 6 configured)",
        "purposesheadingroleextended": "Purposes extended role (2 of 6 configured)",
        "templatetenantmodal": false,
        "instances": [
            {
                "name": "<a href=\"...\">my first instance</a>",
                "toolname": "ChatGPT",
                "model": "gpt-4o",
                "enabled": true,
                "purposesrolebasic": [{"fullname": "Chat"}, {"fullname": "Translate"}],
                "purposesroleextended": [],
                "nopurposeslink": "<a href=\"...\">Assign purposes</a>"
            }
        ]
    }
}}
<hr>
<div id="local_ai_manager-instancetable-{{uniqid}}" class="local_ai_manager-instancetable" data-tenant="{{tenant}}">
    <div class="d-flex justify-content-between mb-5 align-items-center">
        <div><h3>{{#str}} currentlyusedaitools, local_ai_manager {{/str}}</h3></div>
        <div>
            {{#templatetenantmodal}}
                <button class="btn btn-secondary me-2" data-action="local_ai_manager-showtemplatetenant"><i class="fa fa-wand-magic-sparkles"></i> {{#str}}templatetenant_show, local_ai_manager{{/str}}</button>
            {{/templatetenantmodal}}
            <button id="local_ai_manager-instanceadd_button" class="btn btn-primary"><i class="fa fa-plus"></i> {{#str}}addinstance, local_ai_manager{{/str}}</button>
        </div>
    </div>
    {{> local_ai_manager/instancetable_table }}
    {{#templatetenantmodal}}
        <template data-region="local_ai_manager-templatetenantmodal">
            {{> local_ai_manager/templatetenantmodal }}
        </template>
    {{/templatetenantmodal}}
</div>
{{#js}}
    require(['local_ai_manager/instanceaddmodal'], function(InstanceAddModal) {
        InstanceAddModal.renderInstanceAddModal('#local_ai_manager-instancetable-{{uniqid}}');
    });
    {{#templatetenantmodal}}
    require(['local_ai_manager/templatetenantmodal'], function(TemplateTenantModal) {
        TemplateTenantModal.init('#local_ai_manager-instancetable-{{uniqid}}');
    });
    {{/templatetenantmodal}}
{{/js}}
