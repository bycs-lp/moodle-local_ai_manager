{{!
    @template local_ai_manager/templatetenantmodal

    Body of the modal showing the configuration of the template tenant and offering to apply it to the current tenant.

    Example context (json):
    {
        "applyurl": "https://mymoodle.com/local/ai_manager/tenant_config.php?tenant=mytenant&applytemplatetenant=1&sesskey=abc",
        "instancetable": {
            "purposesheadingrolebasic": "Purposes basic role (3 of 6 configured)",
            "purposesheadingroleextended": "Purposes extended role (2 of 6 configured)",
            "instances": [
                {
                    "name": "Chat tool",
                    "toolname": "ChatGPT",
                    "model": "gpt-4o",
                    "enabled": true,
                    "purposesrolebasic": [{"fullname": "Chat"}],
                    "purposesroleextended": [{"fullname": "Chat"}, {"fullname": "Translate"}],
                    "nopurposeslink": ""
                }
            ]
        }
    }
}}
<div class="local_ai_manager-templatetenantmodal">
    <p>{{#str}} templatetenantmodal_intro, local_ai_manager {{/str}}</p>
    {{#instancetable}}
        {{> local_ai_manager/instancetable_table }}
    {{/instancetable}}
    <div class="d-flex justify-content-end">
        <a class="btn btn-primary" href="{{applyurl}}"
            data-confirmation="modal"
            data-confirmation-type="delete"
            data-confirmation-title-str='["templatetenant_apply", "local_ai_manager"]'
            data-confirmation-content-str='["templatetenant_applyconfirm", "local_ai_manager"]'
            data-confirmation-yes-button-str='["templatetenant_apply", "local_ai_manager"]'
            data-confirmation-destination="{{applyurl}}">
            <i class="fa fa-wand-magic-sparkles"></i> {{#str}} templatetenant_apply, local_ai_manager {{/str}}
        </a>
    </div>
</div>
